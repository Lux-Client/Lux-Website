PORT=3001
NODE_ENV=production

ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-long-random-secret

# Preferred PostgreSQL connection string
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Fallback if DATABASE_URL is not set
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name
DB_SSL=false

# Source MariaDB (only needed for one-time migration script)
# You can use either MARIADB_URL or MARIADB_* values below
MARIADB_URL=
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=your-mariadb-user
MARIADB_PASSWORD=your-mariadb-password
MARIADB_NAME=your-mariadb-db

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
CALLBACK_URL=https://your-domain.tld/auth/google/callback

# Optional, comma-separated
ALLOWED_ORIGINS=https://your-domain.tld

# Optional runtime storage path
DATA_DIR=/app/data

# Email notifications (extension approved/rejected, warn/ban), sent via Resend's SMTP relay.
# Off by default — set EMAIL_ENABLED=true once SMTP_PASS/SMTP_FROM are filled in below.
#
# Where to get them: resend.com dashboard -> "API Keys" -> create a key -> that's SMTP_PASS
# (SMTP_USER is always the literal string "resend", already defaulted in code).
# Also verify your sending domain under "Domains" so mail doesn't land in spam (Resend walks
# you through the SPF/DKIM DNS records). SMTP_FROM must be an address on that verified domain.
EMAIL_ENABLED=false
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=noreply@pluginhub.de
SITE_URL=https://lux.pluginhub.de

LUXCLOUD_JWT_SECRET=
LUXCLOUD_ACCESS_TTL_SECONDS=3600
LUXCLOUD_REFRESH_TTL_DAYS=90
LUXCLOUD_REFRESH_GRACE_MS=30000
LUXCLOUD_EXPIRY_DAYS=15
LUXCLOUD_EXPIRY_WARN_DAYS=8
LUXCLOUD_EXPIRY_FINAL_WARN_DAYS=12
LUXCLOUD_TRASH_RETENTION_DAYS=30
LUXCLOUD_STORAGE_DRIVER=fs
LUXCLOUD_FS_ROOT=
LUXCLOUD_S3_BUCKET=
LUXCLOUD_S3_ENDPOINT=
LUXCLOUD_S3_REGION=auto
LUXCLOUD_S3_ACCESS_KEY_ID=
LUXCLOUD_S3_SECRET_ACCESS_KEY=
LUXCLOUD_S3_FORCE_PATH_STYLE=false
LUXCLOUD_BLOB_REDIRECT=false
LUXCLOUD_PRESIGN_TTL_SECONDS=300
LUXCLOUD_MAX_BLOB_BYTES=209715200
LUXCLOUD_MAX_BATCH_BYTES=4194304
LUXCLOUD_MAX_BATCH_ENTRIES=500
LUXCLOUD_UPLOAD_LIMIT_PER_HOUR=2000
LUXCLOUD_STAGING_DIR=
LUXCLOUD_GC_DRY_RUN=true
LUXCLOUD_GC_GRACE_HOURS=24
LUXCLOUD_GC_BATCH=1000
LUXCLOUD_ORPHAN_OBJECT_DAYS=7
LUXCLOUD_UPLOAD_CLAIM_HOURS=24

# --- Lux Cloud Sync ---------------------------------------------------------
# Master switch. false mounts none of the cloud routes and starts no cloud jobs.
LUXCLOUD_ENABLED=true

# REQUIRED when LUXCLOUD_ENABLED=true and NODE_ENV=production.
# Without it (or under 32 characters) Lux Cloud stays off - the rest of the site
# keeps running. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
LUXCLOUD_JWT_SECRET=

# Storage. fs writes to DATA_DIR/luxcloud-blobs and needs a persistent volume.
LUXCLOUD_STORAGE_DRIVER=fs
# LUXCLOUD_S3_ENDPOINT=
# LUXCLOUD_S3_BUCKET=lux-blobs
# LUXCLOUD_S3_REGION=auto
# LUXCLOUD_S3_ACCESS_KEY_ID=
# LUXCLOUD_S3_SECRET_ACCESS_KEY=

# Safety nets. Leave both on true until the logs have been watched for a week -
# these two jobs are the only ones that delete user data permanently.
LUXCLOUD_GC_DRY_RUN=true
LUXCLOUD_EXPIRY_DRY_RUN=true

# Tuning (all optional, defaults shown)
# LUXCLOUD_EXPIRY_DAYS=15
# LUXCLOUD_TRASH_RETENTION_DAYS=30
# LUXCLOUD_SESSION_STALE_MINUTES=5
# LUXCLOUD_MAX_REVISIONS=20
# LUXCLOUD_KEEP_WORLDS_REVISIONS=3
LUXCLOUD_VERIFY_NEGOTIATE=true
LUXCLOUD_VERIFY_CONCURRENCY=16
